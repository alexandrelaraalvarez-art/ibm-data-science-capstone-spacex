# CELDA 1: Importar librerías
import requests
import pandas as pd
import numpy as np
import datetime

# CELDA 2: Función para obtener datos de SpaceX API
def getSpaceXData():
    url = "https://api.spacexdata.com/v4/launches/past"
    response = requests.get(url)
    data = response.json()
    return data

# CELDA 3: Crear DataFrame
data = getSpaceXData()
df = pd.json_normalize(data)

# CELDA 4: Seleccionar columnas relevantes
df = df[['flight_number', 'date_utc', 'name', 'success', 'rocket', 'launchpad', 'payloads']]

# CELDA 5: Limpiar datos
df['date'] = pd.to_datetime(df['date_utc']).dt.date
df['year'] = pd.to_datetime(df['date_utc']).dt.year

# CELDA 6: Guardar a CSV
df.to_csv('spacex_data.csv', index=False)
print(f"Total de lanzamientos: {len(df)}")
print(f"Columnas: {df.columns.tolist()}")
df.head()