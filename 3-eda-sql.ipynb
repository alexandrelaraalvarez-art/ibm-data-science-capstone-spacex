# CELDA 1: Importar librerías
import pandas as pd
import sqlite3

# CELDA 2: Cargar datos
df = pd.read_csv('spacex_data.csv')

# CELDA 3: Crear base de datos SQL
conn = sqlite3.connect('spacex.db')
df.to_sql('SPACEXTBL', conn, if_exists='replace', index=False)

# CELDA 4: Query 1 - Sitios únicos
query1 = "SELECT DISTINCT LaunchSite FROM SPACEXTBL"
result1 = pd.read_sql(query1, conn)
print("Sitios de lanzamiento:")
print(result1)

# CELDA 5: Query 2 - Payload promedio
query2 = "SELECT LaunchSite, AVG(PayloadMassKG) as AvgPayload FROM SPACEXTBL GROUP BY LaunchSite"
result2 = pd.read_sql(query2, conn)
print("\nPayload promedio por sitio:")
print(result2)

# CELDA 6: Query 3 - Éxitos por año
query3 = "SELECT year, COUNT(*) as Total, SUM(CASE WHEN success=1 THEN 1 ELSE 0 END) as Exitos FROM SPACEXTBL GROUP BY year"
result3 = pd.read_sql(query3, conn)
print("\nLanzamientos por año:")
print(result3)

conn.close()