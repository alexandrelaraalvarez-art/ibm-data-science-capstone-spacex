# CELDA 1: Importar librerías
import folium

# CELDA 2: Coordenadas de sitios
sites = {
    'CCAFS SLC-40': [28.5623, -80.5774],
    'KSC LC-39A': [28.6082, -80.6040],
    'VAFB SLC-4E': [34.6321, -120.6106]
}

# CELDA 3: Crear mapa
m = folium.Map(location=[28.5, -80], zoom_start=5)

# CELDA 4: Agregar marcadores
for site, coords in sites.items():
    folium.Marker(coords, popup=site, icon=folium.Icon(color='red')).add_to(m)
    folium.Circle(coords, radius=1000, color='blue', fill=True, fill_opacity=0.2).add_to(m)

# CELDA 5: Guardar
m.save('spacex_map.html')
print("Mapa guardado")
m