# CELDA 1: Importar librerías
import dash
from dash import dcc, html
from dash.dependencies import Input, Output
import plotly.express as px
import pandas as pd

# CELDA 2: Cargar datos
df = pd.read_csv('spacex_data.csv')

# CELDA 3: Crear app
app = dash.Dash(__name__)

# CELDA 4: Layout
app.layout = html.Div([
    html.H1("SpaceX Dashboard"),
    dcc.Dropdown(id='site-dropdown', options=[
        {'label': 'All Sites', 'value': 'ALL'},
        {'label': 'CCAFS SLC-40', 'value': 'CCAFS'},
        {'label': 'KSC LC-39A', 'value': 'KSC'},
        {'label': 'VAFB SLC-4E', 'value': 'VAFB'}
    ], value='ALL'),
    dcc.Graph(id='success-chart')
])

# CELDA 5: Callback
@app.callback(
    Output('success-chart', 'figure'),
    Input('site-dropdown', 'value')
)
def update_chart(site):
    if site == 'ALL':
        fig = px.pie(df, names='success', title='Success Rate - All Sites')
    else:
        filtered = df[df['launchpad'] == site]
        fig = px.pie(filtered, names='success', title=f'Success Rate - {site}')
    return fig

# CELDA 6: Ejecutar
# app.run_server(debug=True)
print("Dashboard creado")